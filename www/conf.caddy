
file_server {
	index index.html index.htm index.xml schema.html terms.html core.html extended.html
}

rewrite /frbr/core        /frbr/core.html
rewrite /frbr/extended    /frbr/extended.html
rewrite /lifecycle/schema /lifecycle/schema.html
rewrite /changeset/schema /changeset/schema.html
rewrite /riro/ddl         /riro/ddl.html
rewrite /riro/gpt         /riro/gpt.html
rewrite /riro/sdl         /riro/sdl.html
rewrite /whisky/terms     /whisky/terms.html

redir /changesets   /changeset/schema 301
redir /changesets/* /changeset/schema 301

# Namespace documents without an extension are served from the HTML file of the same name.
try_files {path} {path}.html

rewrite /multi-tenant-configuration/schema /multi-tenant-configuration/schema-20090513.html
rewrite /transit/terms/ /transit/terms.html
rewrite /waiver/terms/  /waiver/terms.html

# The kro vocabulary has only a Turtle representation.
rewrite /kro/top /kro/top.ttl
header  /kro/top Content-Type "text/turtle; charset=utf-8"

redir /bio/0.1  /bio/ 301
redir /bio/0.1/ /bio/ 301

# The places schema has only an RDF/XML representation.
rewrite /places/schema.rdf /places/schema.rdf.xml
header  /places/schema.rdf Content-Type "application/rdf+xml; charset=utf-8"

# Vocabulary directories without an index document redirect to the vocabulary's main document.
redir /genealogy                    /genealogy/time 302
redir /genealogy/                   /genealogy/time 302
redir /kro                          /kro/top 302
redir /kro/                         /kro/top 302
redir /multi-tenant-configuration   /multi-tenant-configuration/schema 302
redir /multi-tenant-configuration/  /multi-tenant-configuration/schema 302
redir /places                       /places/schema.rdf 302
redir /places/                      /places/schema.rdf 302
redir /reuters_regions              /reuters_regions/1.0/ 302
redir /reuters_regions/             /reuters_regions/1.0/ 302
redir /reuters_topics               /reuters_topics/1.0/ 302
redir /reuters_topics/              /reuters_topics/1.0/ 302

